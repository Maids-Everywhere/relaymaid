{
  "name": "RelayMaid",
  "dockerComposeFile": ["../compose.yaml", "compose.yaml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/relaymaid",
  "runServices": ["devcontainer", "postgres", "redis"],
  "shutdownAction": "none",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "RelayMaid API",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "postCreateCommand": "cd backend && uv sync --frozen",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  }
}
