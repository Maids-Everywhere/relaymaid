RELAYMAID_ENVIRONMENT=local

POSTGRES_BOOTSTRAP_USER=postgres_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=postgres_bootstrap_password
POSTGRES_DB=postgres

JWT_SECRET_TOKEN=replace-with-a-secret-at-least-32-bytes-long

RELAYMAID_DB_NAME=relaymaid

RELAYMAID_MIGRATOR_USER=relaymaid_migrator
RELAYMAID_MIGRATOR_PASSWORD=relaymaid_migrator_password

RELAYMAID_APP_USER=relaymaid_app
RELAYMAID_APP_PASSWORD=relaymaid_app_password

RELAYMAID_DATABASE_URL=postgresql+psycopg://${RELAYMAID_APP_USER}:${RELAYMAID_APP_PASSWORD}@postgres:5432/${RELAYMAID_DB_NAME}
RELAYMAID_MIGRATION_DATABASE_URL=postgresql+psycopg://${RELAYMAID_MIGRATOR_USER}:${RELAYMAID_MIGRATOR_PASSWORD}@postgres:5432/${RELAYMAID_DB_NAME}
